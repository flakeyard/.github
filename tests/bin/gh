#!/usr/bin/env bash
# Stub of gh for the tests. Logs every call to $CALLS, with the body read
# from stdin on the next line, and answers "gh api" from $FIXTURES.
#
# The answer to "METHOD PATH" is the file "METHOD PATH.json", where "/" in PATH
# is "_" and the query string is dropped; with --paginate, the next pages are
# "METHOD PATH.2.json" and so on. A file "METHOD PATH.status" gives the HTTP
# status, 200 by default.
set -euo pipefail

readonly http_ok=200 http_error=400 last_page=9

log_call() {
  {
    printf '%s' gh
    printf ' %q' "$@"
    printf '\n'
  } >>"$CALLS"
}

# fixture_base METHOD PATH: print the fixture path without its extension.
fixture_base() {
  local method=$1 path=$2 key
  key="$method ${path%%\?*}"
  printf '%s/%s\n' "$FIXTURES" "${key//\//_}"
}

# pages BASE PAGINATE: print the fixture files of every page.
pages() {
  local base=$1 paginate=$2 n
  [[ -e $base.json ]] && printf '%s\n' "$base.json"
  $paginate || return 0
  for ((n = 2; n <= last_page; n++)); do
    [[ -e $base.$n.json ]] && printf '%s\n' "$base.$n.json"
  done
  return 0
}

# answer BASE PAGINATE INCLUDE JQ: print the answer like gh does.
answer() {
  local base=$1 paginate=$2 include=$3 jq_expr=$4 status=$http_ok page
  [[ -e $base.status ]] && status=$(<"$base.status")
  if $include; then
    printf 'HTTP/2.0 %s Status\r\nContent-Type: application/json\r\n\r\n' \
      "$status"
  fi
  if ((status >= http_error)); then
    printf 'gh: error (HTTP %s)\n' "$status" >&2
    return 1
  fi
  while IFS= read -r page; do
    if [[ -n $jq_expr ]]; then jq -rc "$jq_expr" "$page"; else cat "$page"; fi
  done < <(pages "$base" "$paginate")
}

api() {
  local method=GET path='' jq_expr='' paginate=false include=false input=''
  while (($#)); do
    case $1 in
      -X) method=$2 && shift ;;
      --jq) jq_expr=$2 && shift ;;
      --input) input=$2 && shift ;;
      -f | -F) shift ;;
      --paginate) paginate=true ;;
      -i) include=true ;;
      -*) ;;
      *) path=$1 ;;
    esac
    shift
  done
  [[ $input == - ]] && printf '  body: %s\n' "$(jq -c .)" >>"$CALLS"
  answer "$(fixture_base "$method" "$path")" "$paginate" "$include" "$jq_expr"
}

log_call "$@"
if [[ $1 == api ]]; then
  shift
  api "$@"
fi
